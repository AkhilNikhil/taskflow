# =====================================================================
#  TaskFlow V4.9 — environment variables
#  1. Copy this file to ".env"  (cp .env.example .env)
#  2. Replace every <placeholder> with your real value
#  3. NEVER commit ".env" to GitHub
# =====================================================================

# ---------- Database (REQUIRED) ----------
# Supabase -> Connect -> "Session pooler" URI. Must start with postgresql://
DATABASE_URL=postgresql://postgres.<project-ref>:<DB_PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ---------- Supabase Auth (REQUIRED) ----------
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-public-key>
# Optional: only if your project still uses the legacy HS256 JWT secret
SUPABASE_JWT_SECRET=

# ---------- App behaviour ----------
# REQUIRED. The backend refuses to start without this (same as DATABASE_URL).
# The person who signs up with this email becomes the ARCHITECT (super-admin).
ROOT_ARCHITECT_EMAIL=you@example.com
# Public URL of the frontend (used in email links + CORS). Local = http://localhost
FRONTEND_URL=http://localhost
CORS_ORIGINS=http://localhost
# Auto-create database tables on start
RUN_SCHEMA_SYNC=true

# ---------- Email notifications via Brevo (OPTIONAL) ----------
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SENDER=
SMTP_SENDER_NAME=TaskFlow

# ---------- Frontend BUILD-TIME values (baked into the site) ----------
# If you change these you must REBUILD the frontend image.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-public-key>
# Leave both empty: Nginx forwards /api/ to the backend for you
VITE_API_URL=
VITE_DIRECT_BACKEND_URL=

# ---------- Frontend RUNTIME value (Passed to frontend container) ----------
# Address Nginx reverse-proxies /api/ to.
# Local Docker Compose: http://backend:5000 (set automatically)
# Cloud (Render/AWS/Azure): https://your-backend.onrender.com
BACKEND_URL=http://backend:5000
